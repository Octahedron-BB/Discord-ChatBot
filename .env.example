# ==========================================
# Discord Chat AI (EchoMirror) Configuration
# ==========================================

# --- LLM Provider Settings ---
# Options: 'deepseek' (default) or 'gemini'
LLM_PROVIDER=deepseek

# DeepSeek API Configuration (When LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Gemini API Configuration (When LLM_PROVIDER=gemini)
DISCORD_AI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Optional Cloudflare Worker or reverse proxy for Gemini
# GEMINI_PROXY_URL=https://your-worker.workers.dev

# --- Discord Bot Configuration ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Allowed private chat IDs (comma-separated Discord user IDs)
ALLOWED_PRIVATE_IDS=123456789,987654321

# Default display names
TARGET_USER_NAME=me
DEFAULT_FRIEND_NAME=friend

# Friend aliases mapping (JSON format string: {"discord_user_id": "Preferred Name"})
FRIEND_ALIASES_JSON='{"123456789": "Alice"}'

# --- Group Chat / Server Channel Settings ---
# Specific channel ID for automated responses and proactive messaging
AUTO_REPLY_CHANNEL_ID=0

# Probability of replying to messages in the auto-reply channel (0.0 to 1.0)
CHANNEL_REPLY_PROBABILITY=0.5

# --- Proactive Messaging Settings ---
# Inactivity threshold (in hours) to trigger proactive messages in the auto-reply channel
PROACTIVE_IDLE_TIME=24

# Interval (in seconds) to check channel inactivity (default 900s = 15 minutes)
PROACTIVE_CHECK_INTERVAL=900

# --- Persona Configuration ---
# Optional path to a custom persona file (default: current_persona.txt)
PERSONA_FILE=current_persona.txt
# Alternatively, inline persona definition (leave blank to read from PERSONA_FILE)
# PERSONA=

# --- System Settings ---
DEBUG_MODE=false
ANONYMIZED_TELEMETRY=False
